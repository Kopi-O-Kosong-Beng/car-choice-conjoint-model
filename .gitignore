# Local Claude Code settings (machine-specific paths). Shared settings would
# go in .claude/settings.json, which is NOT ignored.
.claude/settings.local.json

# R session junk
.RData
.Rhistory
.Rproj.user/
*.Rproj
.Renviron

# Obsidian workspace state (per-user UI state, not content)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Local Git worktrees
.worktrees/
# Second-track working folders — kept locally, never committed. Anything from
# that track we actually rely on is copied into experiments/iterNN_*/ as a
# proper iteration, and THAT is what is tracked.
ZF */
ZF_*/
SUBMIT_*_CODE_AND_CSV*
probe_calibration*
experiments.zip

# Bulk experiment intermediates from the encoding-leak harness and the
# factorization sweeps. Reproducible from the run.R in each folder; the
# scripts, logs and result tables ARE tracked.
experiments/iter48_encleak/*.rds
experiments/iter49_matfact/*.rds
experiments/iter50_lowrank/*.rds
experiments/iter53_p4head/*.rds
experiments/iter57_deploytrim/*.rds
# iter81's per-seed arms (32 files, ~14 MB). The four bagged members it assembles
# ARE tracked, as model/artifacts/{oof,test}_xgbh_*.rds.
experiments/iter81_honesttree/*.rds

# local working material, never for the repo
Sheil File/
final_submission/
tmp/
report/*.aux
report/*.log
report/*.out
report/*.toc
report/qa*.pdf
report/preview.pdf
report/report_new.pdf
report/report_v2.pdf

# Python bytecode from local script checks
__pycache__/
*.pyc
